# ============================================================
# Smart School Backend — Environment Variables
# Copy this file to .env and fill in your own values.
# NEVER commit .env to version control.
# ============================================================

# ── PostgreSQL (e.g. Neon, Supabase, local) ─────────────────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── JWT Security ─────────────────────────────────────────────
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080
DEV_SHOW_OTP=true

# ── Brevo SMTP (Email OTP) ────────────────────────────────────
SMTP_SERVER=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_KEY=your-brevo-smtp-key-here
SMTP_USER=your-brevo-smtp-login@smtp-brevo.com
SMTP_FROM=your-sender@gmail.com
SMTP_FROM_NAME=Smart School

# ── Cloudinary (File Uploads) ─────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ── Runtime ───────────────────────────────────────────────────
ENVIRONMENT=development
PORT=8000
